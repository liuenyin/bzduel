{
  "name": "school-dice-duel",
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev:client": "vite",
    "dev:server": "node --watch server/index.js",
    "dev": "concurrently \"npm run dev:client\" \"npm run dev:server\"",
    "build": "npx vite build",
    "test": "npm run test:core && npm run test:tactical",
    "test:core": "node --test tests/core_battle.test.js tests/reconnection.test.js tests/ai_strategy.test.js",
    "test:tactical": "node tests/test_card_logic_r1.js",
    "test:e2e": "playwright test",
    "start": "node server/index.js"
  },
  "dependencies": {
    "express": "^4.21.0",
    "gsap": "^3.12.5",
    "socket.io": "^4.8.0",
    "socket.io-client": "^4.8.0",
    "vite": "^6.3.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "concurrently": "^9.1.0",
    "playwright": "^1.62.1"
  }
}
